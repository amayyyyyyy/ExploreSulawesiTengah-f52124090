<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5FAF9"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Explore Sulawesi Tengah"
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="#176B67"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Temukan destinasi menarik di Sulawesi Tengah"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/searchWisata"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="🔍  Cari destinasi wisata..."
        android:textSize="14sp"
        android:textColor="#333333"
        android:textColorHint="#888888"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="#FFFFFF"
        android:layout_marginBottom="10dp"
        android:singleLine="true" />

    <ListView
        android:id="@+id/listWisata"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="10dp"
        android:scrollbars="none" />

</LinearLayout>